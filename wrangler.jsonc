{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "battle-of-joy",
  "compatibility_date": "2026-09-17",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
